<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>metis_ros2_inference</name>
  <version>0.0.1</version>
  <description>ROS2 Jazzy inference node for the Axelera Metis AIPU.
    Subscribes to sensor_msgs/Image and publishes
    vision_msgs/Detection2DArray using the AxRuntime C API.</description>
  <maintainer email="nihal.suri@axelera.ai">Nihal Suri</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 runtime + build dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <!-- System dependencies (resolved by rosdep) -->
  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
